{
  "contract_version": "leader-design-task-staging-auth-e2e-evidence-contract-v2",
  "evidence_version": "leader-design-task-staging-auth-e2e-evidence-v2",
  "runner_version": "leader-design-task-staging-auth-e2e-runner-v2",
  "status": "source_only_operator_ready_auth_user_required",
  "environment": {
    "project_ref": "otulfnouybahfnsycxqn",
    "production_project_ref": "ofewxuqfjhamgerwzull",
    "production_enabled": false,
    "exact_environment_guard_required": true
  },
  "fixture_manifest": {
    "version": "leader-design-task-staging-fixture-manifest-v1",
    "required": true,
    "digest": "sha256",
    "max_lifetime_hours": 24,
    "credentials_allowed": false,
    "production_ref_allowed": false
  },
  "network": {
    "allowed": [
      "/auth/v1/token?grant_type=password",
      "/auth/v1/user",
      "/auth/v1/logout",
      "/functions/v1/leader-crm-design",
      "/rest/v1/leader_orders",
      "/rest/v1/leader_lead_needs",
      "/rest/v1/leader_design_tasks"
    ],
    "forbidden": [
      "/rest/v1/rpc/leader_create_design_task_from_order_rpc",
      "/rest/v1/leader_command_receipts",
      "production project endpoint",
      "service-role request",
      "browser INSERT",
      "browser UPDATE",
      "browser DELETE",
      "browser UPSERT"
    ]
  },
  "safe_read_projections": {
    "leader_orders": [
      "id",
      "order_number",
      "lead_id",
      "project_name",
      "status",
      "priority",
      "deadline",
      "layout_status",
      "layout_link",
      "is_archived",
      "updated_at"
    ],
    "leader_lead_needs": [
      "id",
      "lead_id",
      "need_type",
      "title",
      "need_design",
      "design_reason",
      "deadline_date",
      "status",
      "completeness_score"
    ],
    "leader_design_tasks": [
      "id",
      "order_id",
      "task_status",
      "layout_status",
      "designer_name",
      "deadline",
      "layout_link",
      "created_at"
    ]
  },
  "allowed_suite": {
    "mode": "create_replay_conflicts",
    "steps": [
      {
        "name": "fixture_manifest",
        "expected_status": 0,
        "source": "local"
      },
      {
        "name": "authenticate",
        "expected_http": 200
      },
      {
        "name": "auth_user",
        "expected_http": 200
      },
      {
        "name": "safe_read_before",
        "expected_http": 200,
        "expected_counts": {
          "orders": 1,
          "needs": 1,
          "design_tasks": 0
        }
      },
      {
        "name": "create",
        "expected_http": 201,
        "expected_ok": true,
        "expected_idempotent_replay": false
      },
      {
        "name": "exact_replay",
        "expected_http": 200,
        "expected_ok": true,
        "expected_idempotent_replay": true,
        "same_task_id_as_create": true
      },
      {
        "name": "same_key_modified_payload",
        "expected_http": 409,
        "expected_error_code": "conflict"
      },
      {
        "name": "new_key_active_task",
        "expected_http": 409,
        "expected_error_code": "conflict"
      },
      {
        "name": "safe_read_after",
        "expected_http": 200,
        "expected_counts": {
          "design_tasks": 1
        },
        "same_task_id_as_create": true
      },
      {
        "name": "logout_current_session",
        "expected_http": [
          200,
          204
        ],
        "must_be_last": true
      }
    ]
  },
  "denied_probes": {
    "modes": [
      "forbidden_role",
      "inactive_profile",
      "unknown_role"
    ],
    "expected_http": 403,
    "allowed_error_codes": [
      "forbidden",
      "access_denied",
      "profile_check_failed"
    ],
    "required_step_order": [
      "fixture_manifest",
      "authenticate",
      "auth_user",
      "probe mode",
      "logout_current_session"
    ]
  },
  "evidence_required_fields": [
    "evidence_version",
    "runner_version",
    "started_at",
    "finished_at",
    "project_ref",
    "mode",
    "passed",
    "fixture_manifest",
    "steps",
    "safe_projection_columns",
    "cleanup_required"
  ],
  "evidence_forbidden_material": [
    "email",
    "password",
    "publishable key value",
    "access token",
    "refresh token",
    "Authorization header",
    "service-role key",
    "JWT",
    "production project ref",
    "client contacts",
    "finance",
    "internal comments",
    "task_text"
  ],
  "logout_semantics": {
    "must_complete_before_evidence_is_built": true,
    "must_be_present_in_saved_evidence": true,
    "failed_logout_invalidates_success_evidence": true
  },
  "validator": {
    "source": "tools/validate-design-task-staging-auth-e2e-evidence.mjs",
    "independent_from_runner": true,
    "nonzero_exit_on_invalid_evidence": true,
    "manifest_digest_check": true,
    "step_order_check": true,
    "task_identity_check": true,
    "secret_scan": true,
    "production_ref_scan": true
  },
  "cleanup": {
    "runner_revokes_current_session": true,
    "runner_deletes_auth_user": false,
    "runner_deletes_database_fixtures": false,
    "external_cleanup_order": [
      "receipt",
      "design_event",
      "design_task",
      "need",
      "order",
      "lead",
      "profile",
      "auth_user"
    ]
  },
  "approval_gates": [
    "temporary staging Auth user must be created outside the connector",
    "real authenticated HTTP E2E remains unconfirmed until that user exists",
    "production rollout requires a separate explicit owner decision"
  ]
}
