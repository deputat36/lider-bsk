  "function": "leader-crm-installation",
  "edge_version": 2,
  "edge_sha256": "24183605aad2c5cfcc84ebe14c348dcfce1b68de41a43dcfb973f65cef8cb369",
  "actions": [
    {"action": "installation_job.read", "permission": "installation.read"},
    {"action": "installation_job.update", "permission": "installation.write"}
  ],
  "runner": "tools/run_crm_staging_installation_user_jwt_smoke.mjs",
  "runtime_environment": [
    "STAGING_SUPABASE_URL",
