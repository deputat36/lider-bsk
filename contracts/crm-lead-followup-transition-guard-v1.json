{
  "contract": "crm-lead-followup-transition-guard",
  "version": 1,
  "captured_at": "2026-07-23",
  "repository": "deputat36/lider-bsk",
  "issue": 449,
  "status": "frontend_guard_ready",
  "required_lead_statuses": [
    "КП отправлено",
    "Ждём ответ"
  ],
  "required_offer_actions": [
    "mark-offer-sent"
  ],
  "followup_rule": {
    "field": "leader_leads.next_contact_at",
    "must_parse_as_datetime": true,
    "must_be_after_current_time": true,
    "missing_is_blocked": true,
    "invalid_is_blocked": true,
    "overdue_is_blocked": true
  },
  "behavior": {
    "pure_model": true,
    "capture_phase_guard": true,
    "manual_lead_transition_guarded": true,
    "offer_sent_action_guarded": true,
    "visible_explanation": true,
    "focuses_next_contact_input": true,
    "other_statuses_unaffected": true,
    "other_offer_actions_unaffected": true,
    "historical_data_backfill": false
  },
  "integration": {
    "loader": "crm/v4/assets/v4/lead-analytics-badges-v1.js",
    "model": "crm/v4/assets/v4/lead-followup-transition-guard-model-v1.js",
    "ui_guard": "crm/v4/assets/v4/lead-followup-transition-guard-v1.js",
    "lead_status_selector": "#leadCardSection [data-lead-status]",
    "offer_action_selector": "#offersBox .v4-offer-card button[data-action=mark-offer-sent]",
    "focus_target": "leadNextContactInput"
  },
  "limitations": {
    "server_side_enforcement": false,
    "direct_rest_or_edge_bypass_prevented": false,
    "transactional_status_and_followup_validation": false
  },
  "production_boundary": {
    "production_ddl": false,
    "production_dml": false,
    "edge_deploy": false,
    "auth_changed": false,
    "rls_or_grants_changed": false,
    "storage_changed": false,
    "nav_changed": false
  }
}
