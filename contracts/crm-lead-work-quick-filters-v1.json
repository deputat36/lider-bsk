  "filters": [
    {
      "key": "Новая",
      "label": "Новые",
      "source": "leader_leads.status"
    },
    {
      "key": "overdue_contact",
      "label": "Просрочен контакт",
      "source": "leader_leads.next_contact_at"
    },
    {
      "key": "no_next_contact",
      "label": "Без следующего контакта",
      "source": "leader_leads.next_contact_at"
    },
    {
      "key": "needs_calculation",
      "label": "Нужен расчёт",
      "source": "lead status plus current calculation index",
      "rule": "Нужно пересчитать OR ((В работе OR Уточнение деталей) AND no current calculation)"
    },
    {
      "key": "offer_waiting",
      "label": "КП ждёт ответа",
      "source": "lead status plus sent offer index",
      "rule": "КП отправлено OR Ждём ответ OR linked offer status Отправлено"
    }
  ],
  "reads": {
    "lead_source": "existing crm/v4/assets/v4/leads.js",
    "calculation_table": "leader_lead_calculations",
    "calculation_fields": ["lead_id", "status", "is_current_revision"],
    "offer_table": "leader_commercial_offers",
    "offer_fields": ["lead_id", "status"],
    "lead_ids_limited_to_loaded_list": true,
    "row_limit_each": 500,
    "permission_checks": ["calculations.read", "offers.read"]
  },
  "failure_behavior": {
    "main_lead_list_remains_available": true,
    "lead_only_filters_remain_available": true,
    "workflow_dependent_filters_disabled": true,
    "advanced_filter_resets_to_active_on_read_failure": true
  },
  "interaction": {
    "active_button_aria_pressed": true,
    "click_active_filter_resets_to_active": true,
    "source_search_and_sort_still_apply": true,
    "mobile_layout": true,
