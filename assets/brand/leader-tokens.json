  "spacing": [4, 8, 12, 16, 24, 32, 48, 64, 96],
  "layout": {
    "container": 1180,
    "contentReadable": 760,
    "contentWide": 960,
    "columns": {
      "desktop": 12,
      "tablet": 8,
      "mobile": 4
    }
  },
  "motion": {
    "fastMs": 160,
    "baseMs": 200,
    "easing": "cubic-bezier(.2, .8, .2, 1)"
  },
  "photoOverlay": {
    "light": 0.35,
    "base": 0.45,
    "strong": 0.55
