{
  "meta": {
    "brand": "РА Лидер",
    "version": "1.0",
    "description": "Portable brand tokens for design tools and non-CSS clients. CSS remains the runtime source for the public site."
  },
  "color": {
    "brand": {
      "orange": "#FF6A00",
      "orangeHover": "#E85F00",
      "orangeDark": "#C84F00",
      "orangeSoft": "#FFF3E8",
      "orangeLine": "#FFD2AD"
    },
    "neutral": {
      "950": "#0D0F12",
      "900": "#171717",
      "800": "#242424",
      "700": "#353535",
      "600": "#4B4B4B",
      "500": "#667085",
      "400": "#98A2B3",
      "300": "#D1D5DB",
      "200": "#E5E7EB",
      "100": "#F1F3F5",
      "050": "#F7F7F8",
      "white": "#FFFFFF"
    },
    "semantic": {
      "success": "#168653",
      "successSoft": "#DCFCE7",
      "warning": "#B56A00",
      "warningSoft": "#FEF3C7",
      "error": "#C9362B",
      "errorSoft": "#FEE2E2"
    }
  },
  "typography": {
    "fontBrand": "Manrope, Arial, Helvetica, sans-serif",
    "fontSystem": "Arial, Helvetica, sans-serif",
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
